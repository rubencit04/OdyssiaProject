<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AthyssiaFragment"
    android:background="#EFEFEF">

    <!-- Chat -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rwChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_above="@+id/inputLayout"
        android:layout_alignParentTop="true"
        android:padding="4dp" />

    <!-- Input de mensaje + botón -->
    <RelativeLayout
        android:id="@+id/inputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:padding="6dp">

        <EditText
            android:id="@+id/etMensaje"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/btEnviarMensaje"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:hint="Introduzca un mensaje"
            android:singleLine="true"
            android:background="@drawable/edittext"
            android:minHeight="56dp"
            android:paddingHorizontal="12dp"
            android:fontFamily="@font/antic"
            android:textStyle="bold" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btEnviarMensaje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:backgroundTint="@color/white"
            android:src="@drawable/ic_mandar"
            app:fabCustomSize="54dp" />
    </RelativeLayout>
</RelativeLayout>
