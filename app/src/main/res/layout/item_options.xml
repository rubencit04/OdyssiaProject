<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="180dp"
    app:cardCornerRadius="16dp"
    android:background="@android:color/white"
    android:layout_marginTop="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iwOption"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:cardCornerRadius="16dp"
            android:scaleType="centerCrop"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="10dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/twTitleOption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="?android:attr/textAppearanceSmall"
                android:layout_gravity="center"
                android:textColor="#5294FF"
                android:fontFamily="@font/antic"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/tvLocationOption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="?android:attr/textAppearanceSmall"
                android:textSize="14sp"
                android:fontFamily="@font/antic"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_gravity="center"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_gravity="center"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Horario:"
                        android:textSize="12sp"
                        android:fontFamily="@font/antic"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:layout_gravity="center"/>

                    <TextView
                        android:id="@+id/twTimeOption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="?android:attr/textAppearanceSmall"
                        android:textSize="14sp"
                        android:fontFamily="@font/antic"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:layout_gravity="center"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Precio:"
                        android:textSize="12sp"
                        android:fontFamily="@font/antic"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:layout_gravity="center"/>

                    <TextView
                        android:id="@+id/twPriceOption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="?android:attr/textAppearanceSmall"
                        android:textSize="14sp"
                        android:textColor="#000000"
                        android:fontFamily="@font/antic"
                        android:textStyle="bold"
                        android:layout_gravity="center"/>
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btOpenOption"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/button_bluegradient"
                android:fontFamily="@font/antic"
                android:textStyle="bold"
                android:text="@string/v2_btnAbrir"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                app:backgroundTint="@null" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
